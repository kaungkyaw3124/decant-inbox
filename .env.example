# Copy to .env and fill in real values. Never commit .env.
DB_PASSWORD=change-me

# Telegram API credentials from https://my.telegram.org (Phase 2). Never commit.
TG_API_ID=
TG_API_HASH=

# Dashboard (Phase 4). Signs the login cookie. Generate with:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=
# Cookie is HTTPS-only (tailscale serve gives HTTPS). Set false only for local http testing.
# WEB_COOKIE_SECURE=true

# AI helper (docs/SPEC-v4.6-ai.md, OpenAI). Never commit the key.
OPENAI_API_KEY=
# AI_PROVIDER=openai   # openai | off
# AI_MODEL=gpt-6-luna
# AI_REASONING=low     # low | medium

# Test payment code (docs/SPEC-v4.14-test-payment-code.md): 8+ letters/digits your test account sends instead
# of a payment screenshot. Empty = off. Never commit the real one.
TEST_PAY_CODE=

# docs/SPEC-v5.0-go-live-pack.md (empty = off). Alert bot: create it with @BotFather, put its token here,
# send /start to the bot, then run `.venv/bin/python -m scripts.alert_chat_id` and copy the id.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
# Off-server backup: the daily backup is encrypted with this and sent to the alert bot chat.
# Save it in your password manager: without it the backup files cannot be opened.
BACKUP_PASSPHRASE=
